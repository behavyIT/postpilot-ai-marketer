# Скопируйте в .env и заполните. Файл .env не коммитится в git.

# --- Окружение ---
APP_ENV=dev
LOG_LEVEL=INFO
# true — логи в JSON (для сервера), false — читаемые логи в консоли
LOG_JSON=false
DEFAULT_TIMEZONE=Europe/Moscow

# --- Хранилища (docker compose: PostgreSQL на 5433, Redis на 6380) ---
DATABASE_URL=postgresql+asyncpg://aimarketer:aimarketer@localhost:5433/aimarketer
TEST_DATABASE_URL=postgresql+asyncpg://aimarketer:aimarketer@localhost:5433/aimarketer_test
REDIS_URL=redis://localhost:6380/0

# --- Telegram ---
# Токен бота от @BotFather (вида 1234567890:AA...)
TELEGRAM_BOT_TOKEN=
# Необязательно: прокси для api.telegram.org, например socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# --- GigaChat (Freemium для физлиц) ---
# Authorization key из developers.sber.ru → проект GigaChat API → «Настройки API» → «Получить ключ»
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_SMART=GigaChat-3-Ultra
GIGACHAT_MODEL_FAST=GigaChat-2
